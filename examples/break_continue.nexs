// `break` leaves the inner `while` when x reaches 5; `continue` skips j == 2 in the
// `for` sum. Expected: 5 + (0 + 1 + 3 + 4) = 13.
fn main() -> i32 {
    let mut x: i32 = 0;
    while (x < 10) {
        x = x + 1;
        if (x == 5) {
            break;
        }
    }
    let mut sum: i32 = 0;
    for (let mut j: i32 = 0; j < 5; j = j + 1) {
        if (j != 2) {
            sum = sum + j;
        } else {
            continue;
        }
    }
    return x + sum;
}
