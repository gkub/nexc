fn sum_even_to(limit: i32) -> i32 {
    let mut i: i32 = 0;
    let mut total: i32 = 0;

    while (i <= limit) {
        if (i % 2 == 0) {
            total = total + i;
        } else {
            total = total;
        }

        i = i + 1;
    }

    return total;
}

fn main() -> i32 {
    return sum_even_to(10);
}
