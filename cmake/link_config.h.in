/*
 * Generated by CMake at configure time.
 *
 * When NEXC_CONFIGURED_NATIVE_LINK is 1, `nexc ... -o out` may run external LLVM
 * tools discovered at configure time. Exactly one of NEXC_HOST_LINK_USE_LINUX_LD_LLD
 * or NEXC_HOST_LINK_USE_DARWIN_CLANG is 1 for a given build.
 *
 * Linux: `llc` emits an ELF relocatable object; `ld.lld` is invoked with explicit
 * glibc CRT objects and -lc (same family as a hosted C link). Paths come from
 * `${CMAKE_C_COMPILER} -print-file-name=...` at configure time.
 *
 * Darwin: `llc` emits a Mach-O relocatable object; the final link uses the host
 * `clang` binary as the linker driver so the platform supplies CRT, SDK, and
 * libSystem. Invoking `ld.lld` with Linux ELF flags on macOS is not supported.
 *
 * Reconfigure after moving the build tree or changing the toolchain install.
 */
#pragma once

#define NEXC_CONFIGURED_NATIVE_LINK @NEXC_CONFIGURED_NATIVE_LINK@

#define NEXC_HOST_LINK_USE_LINUX_LD_LLD @NEXC_HOST_LINK_USE_LINUX_LD_LLD@
#define NEXC_HOST_LINK_USE_DARWIN_CLANG @NEXC_HOST_LINK_USE_DARWIN_CLANG@

#if NEXC_CONFIGURED_NATIVE_LINK

#define NEXC_LLC_PATH "@NEXC_LLC_PATH@"

#if NEXC_HOST_LINK_USE_LINUX_LD_LLD

#define NEXC_LD_LLD_PATH "@NEXC_LD_LLD_PATH@"
#define NEXC_LINUX_DYNAMIC_LINKER "@NEXC_LINUX_DYNAMIC_LINKER@"
#define NEXC_SCRT1_PATH "@NEXC_SCRT1_PATH@"
#define NEXC_CRTI_PATH "@NEXC_CRTI_PATH@"
#define NEXC_CRTN_PATH "@NEXC_CRTN_PATH@"
#define NEXC_LIBDIR_FOR_LC "@NEXC_LIBDIR_FOR_LC@"

#endif

#if NEXC_HOST_LINK_USE_DARWIN_CLANG

#define NEXC_DARWIN_CLANG_PATH "@NEXC_DARWIN_CLANG_PATH@"

#endif

#endif
